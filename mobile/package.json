{
  "name": "@vitana/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:all": "eas build --platform all",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "update": "eas update",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "inject:school": "node scripts/inject-school-config.js"
  },
  "dependencies": {
    "@amplitude/analytics-react-native": "^1.5.56",
    "@expo/metro-runtime": "~56.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^3.10.0",
    "@livekit/react-native": "^2.11.0",
    "@livekit/react-native-webrtc": "^144.1.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@sentry/react-native": "^7.11.0",
    "@tanstack/react-query": "^5.60.0",
    "axios": "^1.7.0",
    "drizzle-orm": "^0.45.2",
    "expo": "~56.0.11",
    "expo-application": "~56.0.3",
    "expo-constants": "~56.0.18",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.20",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.6",
    "expo-image": "~56.0.11",
    "expo-linking": "~56.0.14",
    "expo-local-authentication": "~56.0.4",
    "expo-notifications": "~56.0.17",
    "expo-router": "~56.2.10",
    "expo-screen-capture": "~56.0.4",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "expo-updates": "~56.0.19",
    "expo-web-browser": "~56.0.5",
    "nativewind": "^4.1.0",
    "react": "19.2.3",
    "react-hook-form": "^7.54.0",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.25.2",
    "tailwindcss": "^3.4.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.1.17",
    "babel-plugin-module-resolver": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^56.0.4",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "ts-jest": "^29.1.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "src/screens/__tests__/",
      "src/components/common/__tests__/FeatureErrorBoundary"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|@react-native/.*|@react-native-community/.*|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@hookform|zustand|@sentry/.*|@amplitude/.*|test-renderer|\\.pnpm)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^react-native-screens$": "<rootDir>/__mocks__/react-native-screens.js",
      "^expo-router$": "<rootDir>/__mocks__/expo-router.js"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/__tests__/**",
      "!src/**/*.d.ts",
      "!src/offline/schema.ts",
      "!src/offline/db.ts",
      "!src/screens/__tests__/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 60,
        "functions": 60,
        "branches": 50,
        "statements": 60
      }
    }
  }
}
