{
  "name": "@vitana/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:all": "eas build --platform all",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "update": "eas update",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "inject:school": "node scripts/inject-school-config.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^3.10.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@shopify/flash-list": "^1.7.0",
    "@shopify/react-native-skia": "1.5.0",
    "@tanstack/react-query": "^5.60.0",
    "@vitana/shared-types": "workspace:*",
    "@vitana/shared-utils": "workspace:*",
    "axios": "^1.7.0",
    "drizzle-orm": "^0.45.2",
    "expo": "~52.0.0",
    "expo-application": "^56.0.3",
    "expo-constants": "^56.0.17",
    "expo-file-system": "~18.0.0",
    "expo-font": "~13.0.0",
    "expo-image": "~2.0.0",
    "expo-local-authentication": "~15.0.0",
    "expo-notifications": "^56.0.16",
    "expo-router": "~4.0.0",
    "expo-screen-capture": "^56.0.4",
    "expo-secure-store": "~14.0.0",
    "expo-splash-screen": "~0.29.0",
    "expo-sqlite": "^56.0.4",
    "expo-status-bar": "~2.0.0",
    "expo-web-browser": "~14.0.0",
    "nativewind": "^4.1.0",
    "react": "18.3.1",
    "react-hook-form": "^7.54.0",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "^4.12.0",
    "react-native-screens": "^4.4.0",
    "tailwindcss": "^3.4.0",
    "victory-native": "^41.26.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^29.5.0",
    "@types/react": "~18.3.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^8.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|@react-native/.*|@react-native-community/.*|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@hookform|zustand|\\.pnpm)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^react-native-screens$": "<rootDir>/__mocks__/react-native-screens.js",
      "^expo-router$": "<rootDir>/__mocks__/expo-router.js"
    }
  }
}
