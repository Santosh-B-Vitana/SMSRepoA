# Vitana SMS Mobile App — Environment Variables
# Copy this file to .env and fill in the values.
# Variables prefixed with EXPO_PUBLIC_ are embedded in the JS bundle (visible to users).
# Variables without that prefix are build-time only.

# ─── API Configuration ────────────────────────────────────────────────────────
EXPO_PUBLIC_API_BASE_URL=http://localhost:5092/api
# Web base URL used for the "Forgot Password" link. Defaults to EXPO_PUBLIC_API_BASE_URL minus /api.
# EXPO_PUBLIC_WEB_BASE_URL=http://localhost:3000
EXPO_PUBLIC_ENV=development

# ─── Sentry (crash reporting + performance) ───────────────────────────────────
# EXPO_PUBLIC_ prefix embeds this value in the JS bundle — do NOT put secrets here.
EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ─── Amplitude (product analytics) ───────────────────────────────────────────
EXPO_PUBLIC_AMPLITUDE_API_KEY=your-amplitude-project-api-key

# ─── White Label (leave empty for the shared Vitana app) ─────────────────────
# SCHOOL_ID=vitana

# ─── Firebase / FCM Push Notifications ───────────────────────────────────────
# EXPO_PUBLIC_FCM_SENDER_ID=your-fcm-sender-id
# Set on backend: Firebase:ServiceAccountPath or Firebase:ServiceAccountJson

# ─── EAS (Expo Application Services) ─────────────────────────────────────────
# EAS_PROJECT_ID=your-eas-project-id
# EXPO_TOKEN=your-expo-token-for-ci

# ─── Build Metadata ────────────────────────────────────────────────────────────
# APP_VERSION=1.0.0
# BUILD_NUMBER=1

# ─── Store Submission (CI only) ───────────────────────────────────────────────
# ASC_APP_ID=your-app-store-connect-app-id
# APPLE_TEAM_ID=your-apple-team-id

# ─── Sentry Source Maps (CI only — never EXPO_PUBLIC_) ────────────────────────
# Used in mobile-eas-production.yml to upload source maps for readable stack traces.
# Store as a GitHub Actions secret: SENTRY_AUTH_TOKEN
# SENTRY_AUTH_TOKEN=sntrys_your_auth_token_here

# ─── Online Classes / LiveKit ─────────────────────────────────────────────────
# The mobile app does NOT need LiveKit keys directly.
# The backend generates room tokens on the fly and returns them in the join API.
# All LiveKit configuration lives in the backend (appsettings.json / env vars).
# No EXPO_PUBLIC_ vars needed here.
#
# For reference, the backend vars you need to set are:
#   LiveKit__ServerUrl      wss://your-project.livekit.cloud
#   LiveKit__ApiKey         APIxxxxxxxxxxxxxxxx
#   LiveKit__ApiSecret      your-livekit-api-secret
#   LiveKit__WebhookSecret  (same as ApiSecret — used to verify webhook signatures)
