# Vitana SMS Mobile App — Environment Variables
# Copy this file to .env and fill in the values.
# Variables prefixed with EXPO_PUBLIC_ are embedded in the JS bundle (visible to users).
# Variables without that prefix are build-time only.

# ─── API Configuration ────────────────────────────────────────────────────────
EXPO_PUBLIC_API_BASE_URL=http://localhost:5092/api
EXPO_PUBLIC_ENV=development

# ─── White Label (leave empty for the shared Vitana app) ─────────────────────
# SCHOOL_ID=vitana

# ─── Firebase / FCM Push Notifications ───────────────────────────────────────
# EXPO_PUBLIC_FCM_SENDER_ID=your-fcm-sender-id
# Set on backend: Firebase:ServiceAccountPath or Firebase:ServiceAccountJson

# ─── EAS (Expo Application Services) ─────────────────────────────────────────
# EAS_PROJECT_ID=your-eas-project-id
# EXPO_TOKEN=your-expo-token-for-ci

# ─── Build Metadata ────────────────────────────────────────────────────────────
# APP_VERSION=1.0.0
# BUILD_NUMBER=1

# ─── Store Submission (CI only) ───────────────────────────────────────────────
# ASC_APP_ID=your-app-store-connect-app-id
# APPLE_TEAM_ID=your-apple-team-id
