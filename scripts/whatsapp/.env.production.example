# ─── Vitana SMS — WhatsApp Test Script — Production Credentials ───────────────
# Copy to .env and fill in real values.
# This file is committed to git as documentation only.
# The actual .env with real credentials is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Meta System User permanent token (never expires) ──────────────────────────
# Get from: business.facebook.com → Settings → System Users
# → vitana-sms-api-prod → Generate Token → app: Vitana SMS Production
# Scopes required: whatsapp_business_messaging, whatsapp_business_management
WHATSAPP_ACCESS_TOKEN=

# ── Phone Number ID ────────────────────────────────────────────────────────────
# Get from: developers.facebook.com → App → WhatsApp → API Setup
# → Phone number ID (e.g. 1157978060731916)
WHATSAPP_PHONE_NUMBER_ID=

# ── WhatsApp Business Account ID ──────────────────────────────────────────────
# Same page → WhatsApp Business Account ID (e.g. 27088955500746088)
WHATSAPP_WABA_ID=

# ── Meta App Secret ────────────────────────────────────────────────────────────
# Get from: developers.facebook.com → App → App Settings → Basic → App secret → Show
# Used for HMAC-SHA256 webhook signature verification
# IMPORTANT: Never commit the real value
WHATSAPP_APP_SECRET=

# ── Webhook Verify Token ───────────────────────────────────────────────────────
# Must match WhatsApp__WebhookVerifyToken in appsettings and Meta webhook config
# You choose this string — keep it in sync across all environments
WHATSAPP_WEBHOOK_VERIFY_TOKEN=vitana_whatsapp_verify

# ── Default test recipient ─────────────────────────────────────────────────────
# Phone number to use for send/ping commands (no + prefix, with country code)
# Must be registered in Meta sandbox: API Setup → Manage phone number list
# Example: 919810861740 = +91 98-1086-1740
WHATSAPP_TEST_RECIPIENT=919810861740

# ── API version ────────────────────────────────────────────────────────────────
WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_BASE=https://graph.facebook.com
