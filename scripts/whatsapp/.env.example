# Copy to .env and fill in values from Meta Developer Console
# cp .env.example .env
#
# Get these from: https://developers.facebook.com → Your App → WhatsApp → API Setup

# Required — temporary token (24h) or permanent System User token
WHATSAPP_ACCESS_TOKEN=

# From API Setup page
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=

# From App Settings → Basic → App Secret (for webhook signature verification)
WHATSAPP_APP_SECRET=

# You choose this — must match what you enter in Meta webhook configuration
WHATSAPP_WEBHOOK_VERIFY_TOKEN=vitana_whatsapp_verify

# Default single-recipient for `send` / `send-all` commands (no + prefix)
# Must be registered in Meta sandbox: API Setup → Manage phone number list
WHATSAPP_TEST_RECIPIENT=

# Configured test numbers (see test_recipients.json — register ALL in Meta sandbox):
#   919963497700  — 9963497700
#   919810861740  — 9810861740 (Manisha / Vedant / Varun Singh)
#   916202166502  — 6202166502 (Revanth Singh)
#   917984177071  — 7984177071 (Aarav Mehta)

# Delay between bulk sends (seconds) — higher = safer, avoids spam flags. Default: 10
WHATSAPP_SEND_DELAY=10

# Optional overrides
WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_BASE=https://graph.facebook.com
