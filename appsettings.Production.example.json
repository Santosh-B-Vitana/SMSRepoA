{
  "_comment": "PRODUCTION CONFIG TEMPLATE — copy values from this file but NEVER store real secrets here. Use environment variables or AWS Secrets Manager for all sensitive values. This file is committed to git as documentation only.",

  "ASPNETCORE_ENVIRONMENT": "Production",
  "DatabaseProvider": "SqlServer",
  "SkipMigrations": false,

  "ConnectionStrings": {
    "DefaultConnection": "ENV:ConnectionStrings__DefaultConnection",
    "CRMConnection":     "ENV:ConnectionStrings__CRMConnection",
    "Redis":             "ENV:ConnectionStrings__Redis"
  },

  "AllowedHosts": "*",

  "JwtSettings": {
    "Issuer":              "SmsApi",
    "Audience":            "SmsApiClient",
    "Secret":              "ENV:JwtSettings__Secret",
    "ExpirationInMinutes": 60
  },

  "Cors": {
    "AllowedOrigins": [
      "https://app.vitanaschools.in",
      "https://admin.vitanaschools.in"
    ],
    "FallbackOrigins": [
      "https://app.vitanaschools.in"
    ]
  },

  "RateLimiting": {
    "MaxLoginAttempts": 5,
    "LockoutDurationMinutes": 15
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Hangfire": "Warning"
    }
  },

  "OpenTelemetry": {
    "ServiceName":    "sms-api-production",
    "ServiceVersion": "1.0.0",
    "OtlpEndpoint":   ""
  },

  "Seq": {
    "ServerUrl": ""
  },

  "FileStorage": {
    "BasePath": "uploads",
    "BaseUrl":  "/files",
    "MaxFileSizeInMB": 10,
    "AllowedExtensions": [".jpg", ".jpeg", ".png", ".pdf", ".doc", ".docx", ".xls", ".xlsx"]
  },

  "Aws": {
    "_comment": "S3 bucket: vitana-website-bucket (eu-north-1 / Stockholm). IAM user: vitana-sms-s3.",
    "AccessKey":      "ENV:Aws__AccessKey",
    "SecretKey":      "ENV:Aws__SecretKey",
    "Region":         "eu-north-1",
    "BucketName":     "vitana-website-bucket",
    "RootFolder":     "SMS-Prod",
    "ServiceUrl":     "",
    "ForcePathStyle": false
  },

  "Email": {
    "SmtpServer":     "email-smtp.ap-south-1.amazonaws.com",
    "SmtpPort":       587,
    "SenderEmail":    "ENV:Email__SenderEmail",
    "SenderPassword": "ENV:Email__SenderPassword",
    "EnableSSL":      true
  },

  "WhatsApp": {
    "_comment": "Meta WhatsApp Business API. Get from Meta Business Manager → WhatsApp → API Setup.",
    "MetaApiBaseUrl":            "https://graph.facebook.com",
    "MetaApiVersion":            "v21.0",
    "SharedPhoneNumberId":       "ENV:WhatsApp__SharedPhoneNumberId",
    "SharedWabaId":              "ENV:WhatsApp__SharedWabaId",
    "SharedAccessToken":         "ENV:WhatsApp__SharedAccessToken",
    "AppSecret":                 "ENV:WhatsApp__AppSecret",
    "WebhookVerifyToken":        "ENV:WhatsApp__WebhookVerifyToken",
    "AccessTokenEncryptionKey":  "ENV:WhatsApp__AccessTokenEncryptionKey",
    "MessageProcessorBatchSize": 50,
    "MaxRetryAttempts":          3
  },

  "LiveKit": {
    "_comment": "LiveKit Cloud project: vitana-sms. Dashboard: https://cloud.livekit.io → your project → Settings → Keys.",
    "ServerUrl":          "ENV:LiveKit__ServerUrl",
    "ApiKey":             "ENV:LiveKit__ApiKey",
    "ApiSecret":          "ENV:LiveKit__ApiSecret",
    "RecordingS3Bucket":  "vitana-website-bucket",
    "RecordingS3Prefix":  "online-class-recordings/",
    "TokenExpiryMinutes": 15,
    "WebhookSecret":      "ENV:LiveKit__WebhookSecret"
  },

  "Groq": {
    "_comment": "Groq Cloud API key for AI-powered WhatsApp message formatting. Get from https://console.groq.com/keys.",
    "ApiKey": "ENV:Groq__ApiKey",
    "Model":  "llama-4-scout-17b-16e-instruct"
  },

  "DefaultAdmin": {
    "Username": "admin",
    "Password": "ENV:DefaultAdmin__Password"
  }
}
