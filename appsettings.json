{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=sms_dev;Username=postgres;Password=postgres",
    "Redis": "",
    "SqlServerExample": "Server=localhost,1433;Database=sms_dev;User Id=sa;Password=YourPassword;TrustServerCertificate=True"
  },
  "DatabaseProvider": "PostgreSQL",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "SmsApi",
    "Audience": "SmsApiClient",
    "Secret": "dev-only-change-this-secret-before-production-123456789",
    "ExpirationInMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:4200",
      "http://localhost:5173",
      "http://localhost:8080"
    ],
    "FallbackOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "RateLimiting": {
    "MaxLoginAttempts": 5,
    "LockoutDurationMinutes": 15
  },
  "OpenTelemetry": {
    "ServiceName": "sms-api",
    "ServiceVersion": "1.0.0",
    "OtlpEndpoint": ""
  },
  "Seq": {
    "ServerUrl": ""
  },
  "FileStorage": {
    "BasePath": "uploads",
    "BaseUrl": "/files",
    "MaxFileSizeInMB": 10,
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".pdf",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx"
    ]
  },
  "DefaultAdmin": {
    "Username": "admin",
    "Password": "admin-dev-change-me"
  }
}
